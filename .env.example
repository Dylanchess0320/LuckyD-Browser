# LuckyD Code Configuration
# Uncomment ONE provider section. The agent auto-detects which API key is set.

# ── DeepSeek (default) ──
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ──
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1
# 2026-09-24: GPT-6 family — gpt-6-astra (flagship), gpt-6-sol (balanced),
# gpt-6-luna (lightweight).

# ── Anthropic ──
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# 2026-09-24: claude-opus-5-5 (Fable-5.1-class, $4/$20 per 1M);
# claude-fable-5-1 is the flagship ($10/$50 per 1M).

# ── xAI (Grok) ──
# XAI_API_KEY=your-xai-key
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1
# 2026-09-24: Grok 4.7 — xAI flagship for coding / long-running agents,
# 500K context, $2/$6 per 1M. Key from https://console.x.ai.

# ── Moonshot (Kimi) ──
# MOONSHOT_API_KEY=your-moonshot-key
# MOONSHOT_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# 2026-09-24: Kimi K3 — open-weight multimodal MoE, 1M context, $3/$15 per 1M.
# Key from https://platform.kimi.ai (OpenAI-compatible).

# ── Google Gemini ──
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-3.8-flash
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Alias: CODING_AGENT_PROVIDER=gemini works the same as google.
# Free API key: https://aistudio.google.com/apikey
# NOTE: Google AI Pro covers the Gemini *app*; the *API* (what LuckyD uses)
# has its own free tier + pay-as-you-go — Pro does not add API quota.
# Free models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro,
# gemini-3-flash-preview, gemini-3-pro-preview, gemma-4-*.
# Image gen (Nano Banana, free tier): browser/models/gemini_media.py
# Video gen (Veo 3.1): same module — needs a BILLING-ENABLED key, it bills
# your Google Cloud project per generation.
# 2TB Drive backup: browser/browser_core/drive_backup.py (one-time OAuth).
# Gemini CLI: npm i -g @google/gemini-cli, then `gemini` in terminal.

# ── Ollama (local) ──
# OLLAMA_MODEL=codellama
# OLLAMA_HOST=http://localhost:11434

# ── Z.ai (GLM) ──
# ZAI_API_KEY=sk-your-zai-key
# ZAI_MODEL=glm-4.5
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── OpenRouter (200+ models) ──
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── ClinePass (Cline flat subscription — Kimi K3 etc., used by the browser) ──
# Optional. Without a key, the browser reuses your logged-in Cline CLI
# session from ~/.cline and refreshes it itself via the stored WorkOS
# refresh token — the Cline terminal does not need to stay open.
# CLINEPASS_API_KEY=     # long-lived key: app.cline.bot → Settings → API Keys
# CLINEPASS_MODEL=cline-pass/kimi-k3
# CLINEPASS_BASE_URL=https://api.cline.bot/api/v1
# ── Cline Usage (credit-billed / free tier, same gateway/auth as ClinePass) ──
# Alias: CODING_AGENT_PROVIDER=cline works the same as cline-usage.
# Free tier 2026 (rotating FREE in CLI/IDE, Cline account, quota-limited):
# minimax-m2.5, deepseek-chat/r1, llama-3.2-3b, gemini-2.0-flash, qwen3-8b,
# kat-coder-pro, glm-5, deepseek-v4-flash, glm-5.3-flash, laguna-s-2.1:free,
# longcat-2.0. Cline CLI: npm i -g cline, then `cline` in terminal.
# CLINE_USAGE_MODEL=deepseek/deepseek-chat

# ── MCP (Model Context Protocol) ──
# See mcp_config.example.json for setup
# CODING_AGENT_MCP_CONFIG=C:/path/to/mcp_config.json

# ── OpenCode Zen (opencode.ai gateway, keyed) ──
# The old $0 keyless tier is gone — needs OPENCODE_API_KEY.
# OPENCODE_API_KEY=<redacted>
# OPENCODE_MODEL=gemini-3.5-flash-lite
# ── Global Settings ──
# CODING_AGENT_PROVIDER=deepseek   # Explicit: deepseek, openai, anthropic, google/gemini, ollama
# CODING_AGENT_MODEL=auto          # Model override
# CODING_AGENT_THINKING=false      # Enable reasoning/thinking mode
# CODING_AGENT_TEMP=0.0
# CODING_AGENT_MAX_TOKENS=8192
# CODING_AGENT_MAX_TURNS=30
# CODING_AGENT_TIMEOUT=120
# CODING_AGENT_LOG_LEVEL=INFO      # DEBUG, INFO, WARNING, ERROR
# CODING_AGENT_LOG_FORMAT=readable # readable or json

# ── LuckyD Deep Research Swarm ──
# Provider: auto = the AI assistant's connected providers via the bridge
# (keyless locals → Cline gateways → keyed clouds; Cline free tier needs no
# key — just a logged-in Cline CLI session), then OpenRouter :free, then
# local Ollama, then Gemini native grounding (only when LuckyD resolves to
# provider=google with a key), else the LuckyD multi-provider stack +
# keyless DDG.
# DRS_PROVIDER=auto                # auto | bridge | cline | gemini | luckyd | opencode | openrouter | ollama | mock
# DRS_SEARCH_BACKEND=auto          # auto | gemini | ddg | tavily | brave | none
# Premium search (optional; unset = keyless DDG + full-page fetch).
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Model overrides (unset = the bridge-resolved model; OpenRouter uses its
# :free pool, Ollama its local default, OpenCode Zen its keyed platform default).
# DRS_OPENCODE_MODEL=gemini-3.5-flash-lite
# DRS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# DRS_OLLAMA_MODEL=llama3.2:3b
# DRS_MODEL_WORKER=gemini-2.5-flash
# DRS_MODEL_PLANNER=gemini-2.5-flash
# DRS_MODEL_SYNTHESIZER=gemini-2.5-flash
# DRS_MODEL_CRITIC=gemini-2.5-flash
# Depth / thoroughness (= the `standard` preset; per-run `depth=` overrides).
# DRS_RESEARCH_ROUNDS=3
# DRS_SEARCHES_PER_ROUND=3
# DRS_MAX_URLS_PER_ROUND=5
# DRS_MAX_PASSAGES_PER_WORKER=12
# DRS_MAX_ITERATIONS=2
# DRS_MAX_PARALLEL=4
# DRS_MIN_COVERAGE=0.82
# DRS_FETCH_TIMEOUT=10
# Cache (SQLite under data/deep_research/cache).
# DRS_CACHE_ENABLED=true
# DRS_CACHE_TTL_DAYS=14
# Budgets, 0 = unlimited (tight budgets finalize best-effort, not fail).
# DRS_MAX_SECONDS=0
# DRS_MAX_LLM_CALLS=0
# DRS_MAX_SEARCH_QUERIES=0
# DRS_MAX_FETCHES=0
