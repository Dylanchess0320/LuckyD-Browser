# LuckyD Code Configuration
# Uncomment ONE provider section. The agent auto-detects which API key is set.

# ── DeepSeek (default) ──
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ──
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic ──
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Google Gemini ──
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Ollama (local) ──
# OLLAMA_MODEL=codellama
# OLLAMA_HOST=http://localhost:11434

# ── Z.ai (GLM) ──
# ZAI_API_KEY=sk-your-zai-key
# ZAI_MODEL=glm-4.5
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── OpenRouter (200+ models) ──
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── ClinePass (Cline flat subscription — Kimi K3 etc., used by the browser) ──
# Optional. Without a key, the browser reuses your logged-in Cline CLI
# session from ~/.cline and refreshes it itself via the stored WorkOS
# refresh token — the Cline terminal does not need to stay open.
# CLINEPASS_API_KEY=     # long-lived key: app.cline.bot → Settings → API Keys
# CLINEPASS_MODEL=cline-pass/kimi-k3
# CLINEPASS_BASE_URL=https://api.cline.bot/api/v1

# ── MCP (Model Context Protocol) ──
# See mcp_config.example.json for setup
# CODING_AGENT_MCP_CONFIG=C:/path/to/mcp_config.json

# ── Global Settings ──
# CODING_AGENT_PROVIDER=deepseek   # Explicit: deepseek, openai, anthropic, google, ollama
# CODING_AGENT_MODEL=auto          # Model override
# CODING_AGENT_THINKING=false      # Enable reasoning/thinking mode
# CODING_AGENT_TEMP=0.0
# CODING_AGENT_MAX_TOKENS=8192
# CODING_AGENT_MAX_TURNS=30
# CODING_AGENT_TIMEOUT=120
# CODING_AGENT_LOG_LEVEL=INFO      # DEBUG, INFO, WARNING, ERROR
# CODING_AGENT_LOG_FORMAT=readable # readable or json

# ── LuckyD Deep Research Swarm ──
# Provider: auto = verified-free OpenCode Zen pool first
# (nemotron-3-ultra-free, $0), then OpenRouter :free, then local Ollama,
# then Gemini native grounding (only when LuckyD resolves to provider=google
# with a key), else the LuckyD multi-provider stack + keyless DDG.
# DRS_PROVIDER=auto                # auto | gemini | luckyd | opencode | openrouter | ollama | mock
# DRS_SEARCH_BACKEND=auto          # auto | gemini | ddg | tavily | brave | none
# Premium search (optional; unset = keyless DDG + full-page fetch).
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Model overrides (unset = verified-free pool per backend:
# planner/critic = nemotron-3-ultra-free, worker/synthesizer =
# nemotron-3.5-lightning-free; OpenRouter equivalents are :free suffixed).
# DRS_OPENCODE_MODEL=nemotron-3-ultra-free
# DRS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# DRS_OLLAMA_MODEL=llama3.2:3b
# DRS_MODEL_WORKER=gemini-2.5-flash
# DRS_MODEL_PLANNER=gemini-2.5-flash
# DRS_MODEL_SYNTHESIZER=gemini-2.5-flash
# DRS_MODEL_CRITIC=gemini-2.5-flash
# Depth / thoroughness (= the `standard` preset; per-run `depth=` overrides).
# DRS_RESEARCH_ROUNDS=3
# DRS_SEARCHES_PER_ROUND=3
# DRS_MAX_URLS_PER_ROUND=5
# DRS_MAX_PASSAGES_PER_WORKER=12
# DRS_MAX_ITERATIONS=2
# DRS_MAX_PARALLEL=4
# DRS_MIN_COVERAGE=0.82
# DRS_FETCH_TIMEOUT=10
# Cache (SQLite under data/deep_research/cache).
# DRS_CACHE_ENABLED=true
# DRS_CACHE_TTL_DAYS=14
# Budgets, 0 = unlimited (tight budgets finalize best-effort, not fail).
# DRS_MAX_SECONDS=0
# DRS_MAX_LLM_CALLS=0
# DRS_MAX_SEARCH_QUERIES=0
# DRS_MAX_FETCHES=0
